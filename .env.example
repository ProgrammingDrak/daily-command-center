# Copy to .env for local development. Do not commit real secrets.

# Required for local sync/persistence. Use the same Postgres target as the
# deployed service, or a local Postgres database with pg-schema.js applied.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Optional local login bypass. Leave off in production.
DCC_LOCAL_AUTH=1
SEED_USERNAME=drake
SEED_PASSWORD=clever123

# Optional local overrides.
PORT=8090
DCC_TIME_ZONE=America/New_York

# Slack reaction capture and server-side reconciliation.
SLACK_SIGNING_SECRET=
# User-token scopes: search:read, reactions:read, reactions:write, and the
# applicable channels:history, groups:history, im:history, mpim:history scopes.
SLACK_USER_TOKEN=
DRAKE_SLACK_USER_ID=
SLACK_WORKSPACE_HOST=cleverrealestate.slack.com
SLACK_RECONCILE_ENABLED=1
SLACK_RECONCILE_INTERVAL_MS=300000
SLACK_API_TIMEOUT_MS=20000
# Required in production. Set once to the rollout instant and keep it stable so
# old 👥 reactions are not imported and restart recovery does not move the cutoff.
SLACK_DELEGATE_IMPORT_AFTER=

# Optional AI refinement. Capture remains fully usable when this is unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_TIMEOUT_MS=30000
SLACK_ENRICHMENT_MODEL=claude-haiku-4-5-20251001
