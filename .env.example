# Copy to .env for local development. Do not commit real secrets.

# Required for local sync/persistence. Use the same Postgres target as the
# deployed service, or a local Postgres database with pg-schema.js applied.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Optional local login bypass. Leave off in production.
DCC_LOCAL_AUTH=1
SEED_USERNAME=drake
SEED_PASSWORD=clever123

# Optional local overrides.
PORT=8090
DCC_TIME_ZONE=America/New_York

# Slack reaction capture and server-side reconciliation. See docs/slack-setup.md.
SLACK_SIGNING_SECRET=
# SHARED BOT TOKEN — this is what lets ONE Slack app serve every DCC user. A
# reaction is routed to whoever reacted (lib/slack-actors.js), so no teammate
# needs their own app. Bot scopes: reactions:read, users:read, users:read.email,
# channels:history, groups:history. The bot only receives reactions in
# conversations it has been invited to.
SLACK_BOT_TOKEN=
# Comma-separated Slack team IDs (T0XXXXXXX) allowed to auto-link a reactor to a
# DCC account by matching their Slack email. UNSET DISABLES AUTO-LINKING
# ENTIRELY, on purpose: without it, anyone who installed this app in their own
# workspace could claim a DCC account by email collision.
SLACK_TEAM_ALLOWLIST=
# Optional per-person user token. Not required any more: it upgrades ONE identity
# from bot tier to user tier, which adds DM and private-channel coverage, the
# `hasmy:` catch-up sweep (search.messages has no bot equivalent), and reactions
# posted as that person rather than as the bot. Paired with DRAKE_SLACK_USER_ID
# below, it is also the env fallback identity that predates the shared bot.
# User-token scopes: search:read, reactions:read, reactions:write, and the
# applicable channels:history, groups:history, im:history, mpim:history scopes.
SLACK_USER_TOKEN=
# The Slack member ID that SLACK_USER_TOKEN belongs to. This is now a FALLBACK
# identity, not the gate: reactions from anyone else are resolved through the
# slack_identities table instead of being dropped.
DRAKE_SLACK_USER_ID=
SLACK_WORKSPACE_HOST=cleverrealestate.slack.com
SLACK_RECONCILE_ENABLED=1
SLACK_RECONCILE_INTERVAL_MS=300000
SLACK_API_TIMEOUT_MS=20000
# Required in production. Set once to the rollout instant and keep it stable so
# old 👥 reactions are not imported and restart recovery does not move the cutoff.
SLACK_DELEGATE_IMPORT_AFTER=

# Optional AI refinement. Capture remains fully usable when this is unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_TIMEOUT_MS=30000
SLACK_ENRICHMENT_MODEL=claude-haiku-4-5-20251001
